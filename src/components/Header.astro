---
import { nav } from '../data/nav';
import { site } from '../data/site';
import { url } from '../data/url';

const strip = (p: string) => p.replace(/\/+$/, '') || '/';
const current = strip(Astro.url.pathname);
const isActive = (href: string) => strip(url(href)) === current;
---
<header class="sticky z-50 border-b border-slate-200 bg-surface/90 backdrop-blur dark:border-slate-700" style="top: env(safe-area-inset-top, 0px)">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href={url('/')} class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-900 dark:text-white">
      <img src={url('/favicon-transparent.png')} alt="" class="h-16 w-16 rounded-lg object-contain" />
      {site.name}
    </a>

    <!-- Menu (desktop) -->
    <nav class="hidden items-center gap-1 sm:flex" aria-label="Main">
      {nav.map((item) =>
        item.cta ? (
          <a href={url(item.href)} class="ml-2 rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">{item.label}</a>
        ) : (
          <a
            href={url(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-white',
              isActive(item.href) ? 'text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-300',
            ]}
          >{item.label}</a>
        )
      )}
    </nav>

    <!-- Menu toggle (mobile) -->
    <button id="menu-btn" class="rounded-md p-2 text-slate-600 hover:bg-slate-100 sm:hidden dark:text-slate-300 dark:hover:bg-slate-800" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <!-- Menu (mobile) -->
  <nav id="mobile-menu" class="hidden border-t border-slate-200 px-4 py-3 sm:hidden dark:border-slate-700" aria-label="Mobile">
    {nav.map((item) => (
      <a
        href={url(item.href)}
        aria-current={isActive(item.href) ? 'page' : undefined}
        class:list={[
          'block rounded-md px-3 py-2 text-base font-medium hover:bg-slate-100 dark:hover:bg-slate-800',
          isActive(item.href) ? 'text-brand-600 dark:text-brand-400' : 'text-slate-700 dark:text-slate-200',
        ]}
      >{item.label}</a>
    ))}
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
</script>
