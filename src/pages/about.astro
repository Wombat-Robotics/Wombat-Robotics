---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About | Site Template">
  <div class="grid gap-12 py-16 sm:py-24 md:grid-cols-5">
    <div class="md:col-span-3">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white">About us</h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600 dark:text-slate-400">Tell your story here: who you are, why you started, and what you care about.</p>
      <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-400">Add a second paragraph with more detail. Keep lines short enough to read comfortably, around 60 to 75 characters.</p>
    </div>
    <dl class="space-y-6 md:col-span-2">
      <div class="border-l-4 border-indigo-600 pl-4">
        <dt class="font-semibold text-slate-900 dark:text-white">Our mission</dt>
        <dd class="mt-1 text-sm text-slate-600 dark:text-slate-400">One sentence about what you aim to do.</dd>
      </div>
      <div class="border-l-4 border-indigo-600 pl-4">
        <dt class="font-semibold text-slate-900 dark:text-white">Our team</dt>
        <dd class="mt-1 text-sm text-slate-600 dark:text-slate-400">A short note about who is behind the work.</dd>
      </div>
    </dl>
  </div>
</BaseLayout>
